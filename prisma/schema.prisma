generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  role_name String   @unique // e.g. superadmin, setwan, anggota
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Jabatan {
  id           Int      @id @default(autoincrement())
  jabatan_name String
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("jabatan")
}

model Fraksi {
  id          Int      @id @default(autoincrement())
  fraksi_name String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fraksi")
}

model Komisi {
  id          Int      @id @default(autoincrement())
  komisi_name String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("komisi")
}

model Akd {
  id        Int       @id @default(autoincrement())
  akd_name  String
  users     UserAkd[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("akd")
}

model User {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password      String
  photo         String?
  role_id       String
  jabatan_id    Int?
  fraksi_id     Int?
  komisi_id     Int?
  device_id     String?
  browser_agent String?
  role          Role            @relation(fields: [role_id], references: [id])
  jabatan       Jabatan?        @relation(fields: [jabatan_id], references: [id])
  fraksi        Fraksi?         @relation(fields: [fraksi_id], references: [id])
  komisi        Komisi?         @relation(fields: [komisi_id], references: [id])
  akds          UserAkd[]
  attendance    Attendance[]
  news          News[]
  messages      Message[]
  todos         TodoList[]
  agendaCatatan AgendaCatatan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserAkd {
  id      Int  @id @default(autoincrement())
  user_id Int
  akd_id  Int
  user    User @relation(fields: [user_id], references: [id])
  akd     Akd  @relation(fields: [akd_id], references: [id])

  @@unique([user_id, akd_id])
  @@map("user_akd")
}

model Agenda {
  id          Int             @id @default(autoincrement())
  title       String
  description String?         @db.Text
  location    String?
  date        DateTime        @db.Date
  start_time  DateTime        @db.Time
  end_time    DateTime        @db.Time
  type        String? // e.g. Rapat Paripurna, dll
  targets     AgendaTarget[]
  attendance  Attendance[]
  catatan     AgendaCatatan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agenda")
}

model AgendaTarget {
  id          Int    @id @default(autoincrement())
  agenda_id   Int
  target_type String // e.g., komisi, fraksi, akd
  target_id   Int
  agenda      Agenda @relation(fields: [agenda_id], references: [id], onDelete: Cascade)

  @@map("agenda_target")
}

model AgendaCatatan {
  id        Int    @id @default(autoincrement())
  agenda_id Int
  user_id   Int
  note      String @db.Text
  agenda    Agenda @relation(fields: [agenda_id], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([agenda_id, user_id])
  @@map("agenda_catatan")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  agenda_id Int
  user_id   Int
  date      DateTime @db.Date
  time      DateTime @db.Time
  location  String?
  photo     String?  @db.Text
  agenda    Agenda   @relation(fields: [agenda_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([agenda_id, user_id])
  @@map("attendance")
}

model News {
  id           Int       @id @default(autoincrement())
  title        String
  summary      String?   @db.Text
  content      String    @db.Text
  photo        String?
  view_count   Int       @default(0)
  status_code  Int       @default(1) // e.g., 1=draft, 2=published, 3=archived
  status_label String    @default("draft") // e.g., "draft", "published", "archived"
  author_id    Int
  author       User      @relation(fields: [author_id], references: [id])
  tags         NewsTag[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("news")
}

model NewsTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  news      News[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_tags")
}

model Message {
  id          Int      @id @default(autoincrement())
  sender_id   Int
  target_type String // e.g., 'user', 'all', 'komisi', 'fraksi', 'akd', 'role'
  target_id   String?
  content     String   @db.Text
  sender      User     @relation(fields: [sender_id], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("messages")
}

model TodoList {
  id        Int      @id @default(autoincrement())
  user_id   Int
  task      String
  status    Int      @default(0) // 0 = belum, 1 = selesai
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todo_list")
}
